# ============================================================
# ResQNet Frontend — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in values for your environment.
#
#   cp .env.example .env
#
# IMPORTANT:
#   - Never commit .env to version control.
#   - Only VITE_* variables are exposed to the browser bundle.
#   - Do NOT place private credentials or API secrets in VITE_
#     variables — they will be inlined into the public JS bundle.
#   - For secrets (database passwords, signing keys, etc.) use
#     server-side environment variables only, never VITE_ prefixed ones.
# ============================================================

# --- Application Identity -----------------------------------
# Human-readable title shown in the browser tab and page header.
VITE_APP_TITLE=ResQNet Operations Command

# Runtime environment label (development | staging | production).
VITE_APP_ENV=development

# --- Data Mode ----------------------------------------------
# Controls whether the frontend uses synthetic demo data or
# calls the live backend API.
#
#   demo  — All results are pre-computed synthetic scenarios.
#           No backend connection is required.
#           Safe for demonstration and UI development.
#
#   live  — All service calls go to VITE_API_BASE_URL.
#           Mock fallbacks are strictly disabled.
#           Requires the ResQNet backend to be reachable.
#
VITE_DATA_MODE=demo

# --- Backend API (Live Mode only) ---------------------------
# Base URL for the ResQNet FastAPI backend.
# Used only when VITE_DATA_MODE=live.
# Example for local development: http://localhost:8000/api/v1
# Example for staging:           https://api.staging.resqnet.example.com/api/v1
#
# NOTE: This URL is embedded in the client bundle and must NOT
# contain credentials. The backend must enforce its own auth.
#
VITE_API_BASE_URL=http://localhost:8000/api/v1
