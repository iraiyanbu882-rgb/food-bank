# ============================================================
# ResQNet Frontend — .gitignore
# ============================================================

# --- Dependency directories ----------------------------------
node_modules/
frontend/node_modules/
backend/.venv/

# --- Production build output --------------------------------
dist/
dist-ssr/
frontend/dist/
backend/data/
backend/.pytest_cache/
backend/**/__pycache__/

# --- Environment variable files -----------------------------
# Never commit real credentials — use .env.example as template
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# --- Local Vite override files ------------------------------
*.local

# --- Editor and OS artefacts --------------------------------
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
frontend/.vscode/settings.json
frontend/.idea/

# --- Logs ---------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Coverage / test output ---------------------------------
coverage/
*.lcov

# --- Misc ---------------------------------------------------
*.tgz
*.zip
