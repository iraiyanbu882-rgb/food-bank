# ============================================================
# ResQNet Frontend — .gitignore
# ============================================================

# --- Dependency directories ----------------------------------
node_modules/

# --- Production build output --------------------------------
dist/
dist-ssr/

# --- Environment variable files -----------------------------
# Never commit real credentials — use .env.example as template
.env
.env.*
!.env.example

# --- Local Vite override files ------------------------------
*.local

# --- Editor and OS artefacts --------------------------------
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# --- Logs ---------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Coverage / test output ---------------------------------
coverage/
*.lcov

# --- Misc ---------------------------------------------------
*.tgz
*.zip
